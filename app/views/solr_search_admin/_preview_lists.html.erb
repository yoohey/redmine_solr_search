<%# The two lists of a trial search side by side (the fine tuning tab and the dictionary tab): lists = [[label key, rows, show the move from the first list], ...] %>
  <div class="solr-search-tuning-lists">
    <% lists.each do |label, rows, compare| %>
      <div>
        <h4><%= l(label) %></h4>
        <% if rows.empty? %>
          <p class="nodata"><%= l(:label_no_data) %></p>
        <% else %>
          <table class="list">
            <thead><tr><th>#</th><th><%= l(:label_solr_search_tuning_kind) %></th><th><%= l(:label_solr_search_tuning_title) %></th><th><%= l(:label_solr_search_tuning_score) %></th><% if compare %><th><%= l(:label_solr_search_tuning_move) %></th><% end %></tr></thead>
            <tbody>
              <% rows.each do |row| %>
                <tr>
                  <td><%= row[:rank] %></td><td><%= row[:kind] %></td><td><%= row[:title] %></td><td><%= number_with_precision(row[:score], precision: 2) %></td>
                  <% if compare %><td><%= tuning_move_text(row[:rank], row[:was]) %></td><% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    <% end %>
  </div>
