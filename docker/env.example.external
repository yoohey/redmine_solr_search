# external: for the Redmine you already run, with external sources. One Solr, Tika and ManifoldCF; no Redmine here.
#   cp env.example.external .env      (set MCF_SOURCE_DIR below to the folder to crawl)
#   docker compose up -d
# Tell Redmine where Solr and Tika are and run the scheduler there (see env.example.minimal, also before changing *_BIND). ManifoldCF:
# http://localhost:8345/mcf-crawler-ui/ (admin / admin). Make the source with docker/manifoldcf/add-folder.
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.solr.yaml:compose.tika.yaml:compose.manifoldcf.yaml
# with monitoring (Grafana at http://localhost:3001/, admin / admin): use this line instead
#COMPOSE_FILE=compose.solr.yaml:compose.tika.yaml:compose.manifoldcf.yaml:compose.monitoring.yaml

MCF_SOURCE_DIR=./data/mcf-source
MCF_SOURCE_PATH=/source
SOLR_BIND=127.0.0.1
SOLR_PORT=8983
TIKA_BIND=127.0.0.1
TIKA_PORT=9998
SOLR_HEAP=512m
