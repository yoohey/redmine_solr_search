# windows: the Windows starter. Redmine with sample data, one Solr and Tika in Docker (WSL2); ManifoldCF is installed on
# Windows itself (it reads your folders directly, which is much faster than from inside WSL2). See the Windows guide.
#   cp env.example.windows .env
#   docker compose up -d
# Redmine: http://localhost:3000/ (admin / password). ManifoldCF on Windows sends to Solr at http://localhost:8983/solr
# and to Tika at http://localhost:9998.
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.redmine.yaml:compose.solr.yaml:compose.tika.yaml

# Solr and Tika must be reached from Windows: inside WSL2 they listen on every address. Who can reach that depends on
# WSL2's networking: with NAT (the default) not other PCs, unless Windows forwards the ports; in mirrored mode the LAN
# may, as far as the firewall lets it. Neither has a login: for trying it out, on a network you trust.
SOLR_BIND=0.0.0.0
TIKA_BIND=0.0.0.0

# Fine as they are for trying it out. Change them before anyone else can reach it.
SEED_PASSWORD=password
DB_PASSWORD=redmine
SECRET_KEY_BASE=change-me-this-is-for-trying-it-out-only
REDMINE_PORT=3000
REDMINE_VERSION=6.1.5
SOLR_HEAP=512m
