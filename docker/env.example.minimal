# minimal: for the Redmine you already run. One Solr and Tika; no Redmine here.
#   cp env.example.minimal .env
#   docker compose up -d
# Then tell Redmine where they are: SOLR_URL=http://127.0.0.1:8983/solr and TIKA_URL=http://127.0.0.1:9998 for Redmine and
# its scheduler (or the status tab of the plugin's admin page). Redmine on another host: this host's address instead, and
# SOLR_BIND / TIKA_BIND below. The scheduler is not here: run it where Redmine is (rake redmine:solr_search:scheduler).
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.solr.yaml:compose.tika.yaml
# with monitoring (Grafana at http://localhost:3001/, admin / admin): use this line instead
#COMPOSE_FILE=compose.solr.yaml:compose.tika.yaml:compose.monitoring.yaml

# Where Solr and Tika listen. 127.0.0.1: only Redmine on this same host reaches them. For a Redmine on another host,
# the address of this host on the network between them (and keep anyone else away from Solr and Tika: they have
# no login; ufw does not filter the ports Docker publishes: use the DOCKER-USER chain or a firewall outside this host).
SOLR_BIND=127.0.0.1
SOLR_PORT=8983
TIKA_BIND=127.0.0.1
TIKA_PORT=9998
SOLR_HEAP=512m
