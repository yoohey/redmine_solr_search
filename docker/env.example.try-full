# try-full: everything, as in a production-like setup. Redmine with sample data, SolrCloud (2 Solr, 3 ZooKeeper, nginx),
# Tika, ManifoldCF and monitoring. About 4 to 8 GB of memory, by the Solr heap (docs/docker.md).
#   cp env.example.try-full .env
#   docker compose up -d
# Redmine: http://localhost:3000/ (admin / password). Grafana: http://localhost:3001/ (admin / admin).
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.redmine.yaml:compose.solrcloud.yaml:compose.tika.yaml:compose.manifoldcf.yaml:compose.monitoring.yaml

MCF_SOURCE_DIR=./data/mcf-source
MCF_SOURCE_PATH=/source
METRICS_TOKEN=change-me-metrics-token
GRAFANA_ADMIN_PASSWORD=admin

# Fine as they are for trying it out. Change them before anyone else can reach it.
SEED_PASSWORD=password
DB_PASSWORD=redmine
SECRET_KEY_BASE=change-me-this-is-for-trying-it-out-only
REDMINE_PORT=3000
REDMINE_VERSION=6.1.5
SOLR_HEAP=1g
