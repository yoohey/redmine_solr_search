{
 "uid": "redmine-solr-overview",
 "title": "Redmine Solr 検索の概況",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "redmine-solr"
 ],
 "panels": [
  {
   "id": 100,
   "title": "サービスの状態",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 7,
   "title": "サービスの稼働状況（Redmine・Solr・Tika・ManifoldCF）",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down"
        },
        "1": {
         "text": "Up"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"probe\"}",
     "legendFormat": "{{service}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"solr\"}",
     "legendFormat": "solr {{instance}}"
    }
   ],
   "description": "各サービスに、外から問い合わせて答えがあるかです。「Down」なら、そのサービスが落ちています。まず docker compose ps と docker compose logs で、そのサービスを確かめます。",
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 8,
   "title": "レプリカの状態",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 16,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Not active"
        },
        "1": {
         "text": "Active"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min by (collection, replica, node_name) (solr_collections_replica_state)",
     "legendFormat": "{{collection}} {{replica}} @ {{node_name}}",
     "instant": true
    }
   ],
   "description": "Solr のレプリカ（コアの写し）が使える状態かです。「Not active」は、止まっているか復旧中です。1つでも止まっていると、冗長性がなくなります。管理ページのレプリカの表で、どのコアかを見ます。（今の値だけを出す。状態が変わった直後の約5分は、前の状態の記録も残るので、どちらかが「Not active」なら「Not active」と出す。コレクションを作った直後や、レプリカが戻った直後は、約5分「Not active」のことがある）"
  },
  {
   "id": 9,
   "title": "Solr の稼働ノード数",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 8,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "solr_collections_live_nodes",
     "legendFormat": "nodes"
    }
   ],
   "description": "ZooKeeper が、生きていると見ている Solr のノードの数です。このセットでは2が正常で、1なら片方が落ちています（検索は続きますが、冗長性はありません）。"
  },
  {
   "id": 10,
   "title": "スケジューラーの最終応答",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 120
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "solr_search_scheduler_heartbeat_age_seconds",
     "legendFormat": "scheduler"
    }
   ],
   "description": "常駐のスケジューラーが最後に動いてからの時間です。2分で橙、5分で赤です。赤なら、スケジューラーが止まっているので、定期クロールが動いていません。docker compose logs scheduler を見て、再起動します。"
  },
  {
   "id": 11,
   "title": "処理の最終結果",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 10,
    "w": 9,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Failed"
        },
        "1": {
         "text": "Success"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "solr_search_task_last_success",
     "legendFormat": "{{task}}"
    }
   ],
   "description": "定期クロールなどの処理の、最後の実行が成功したかです。「Failed」なら、管理ページの「最後の実行」で、理由を見ます。"
  },
  {
   "id": 12,
   "title": "前回の処理からの経過時間",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 10,
    "w": 9,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - solr_search_task_last_finished_timestamp_seconds",
     "legendFormat": "{{task}}"
    }
   ],
   "description": "処理の最後の実行が終わってからの時間です。処理ごとの間隔より大幅に長いなら、スケジューラーか処理が止まっています。"
  },
  {
   "id": 101,
   "title": "Solr の性能",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 1,
   "title": "検索数（毎秒・コレクション別）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (collection) (rate(solr_metrics_core_requests_total{handler=\"/select\",type=\"requests\"}[1m]))",
     "legendFormat": "{{collection}}"
    }
   ],
   "description": "Solr が受けた検索（/select）の回数です。急に0になったら、検索が止まっているか、Redmine から届いていません。まず上の「サービスの稼働状況」と、管理ページの状態を見ます。"
  },
  {
   "id": 2,
   "title": "検索エラー数（直近5分・コレクション別）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "decimals": 0,
     "custom": {
      "axisSoftMax": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (collection, type) (increase(solr_metrics_core_requests_total{handler=\"/select\",type=~\"errors|timeouts\"}[5m]))",
     "legendFormat": "{{collection}} {{type}}"
    }
   ],
   "description": "Solr が返した検索のエラー（クライアントの誤りとサーバーの誤り）の、直近5分の件数です。0が正常です。増えたら、Solr のログ（docker compose logs solr1）と、管理ページの接続の状態を見ます。"
  },
  {
   "id": 3,
   "title": "応答時間（平均・中央値、ミリ秒）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (collection) (solr_metrics_core_request_time_ms_sum{handler=\"/select\"}) / sum by (collection) (solr_metrics_core_request_time_ms_count{handler=\"/select\"})",
     "legendFormat": "{{collection}} mean"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (collection) (solr_metrics_core_request_time_ms{handler=\"/select\",quantile=\"0.5\"})",
     "legendFormat": "{{collection}} median"
    }
   ],
   "description": "Solr の中で、検索1回にかかった時間です（最近の検索の平均と中央値）。目安は数十ミリ秒です。何百ミリ秒にもなったら、メモリ（JVM のヒープ）と、同時に重い処理（インデックスの作り直し）が動いていないかを見ます。なお、Solr のこの数字は累積の回数ではないので、速さの変化を見る用です。"
  },
  {
   "id": 4,
   "title": "応答時間（p99・p99.9、最も遅いレプリカ、ミリ秒）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (collection) (solr_metrics_core_request_time_ms{handler=\"/select\",quantile=\"0.99\"})",
     "legendFormat": "{{collection}} p99"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (collection) (solr_metrics_core_request_time_ms{handler=\"/select\",quantile=\"0.999\"})",
     "legendFormat": "{{collection}} p99.9"
    }
   ],
   "description": "検索のうち遅い方（100回に1回、1000回に1回）の時間です。平均が良くても、これが大きいと、たまに遅い検索があります。大きいときは、遅いレプリカを調べます。"
  },
  {
   "id": 5,
   "title": "JVM ヒープ使用量",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "solr_metrics_jvm_heap{item=\"used\",memory=\"heap\"}",
     "legendFormat": "{{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(solr_metrics_jvm_heap{item=\"max\",memory=\"heap\"})",
     "legendFormat": "max heap"
    }
   ],
   "description": "Solr が使っているメモリ（Java のヒープ）です。上限（-Xmx）に張り付いたままなら、メモリ不足です。Solr のメモリを増やすか、インデックスの量を見直します。"
  },
  {
   "id": 6,
   "title": "コアの文書数",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (collection) (solr_metrics_core_searcher_documents{type=\"numDocs\"})",
     "legendFormat": "{{collection}}"
    }
   ],
   "description": "コアに入っている文書の数です。同じコレクションのコアで数が大きく違うなら、レプリカが遅れています。管理ページのレプリカの表を見ます。"
  },
  {
   "id": 38,
   "title": "インデックスサイズ（1レプリカあたり）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (collection) (solr_metrics_core_index_size_bytes)",
     "legendFormat": "{{collection}}"
    }
   ],
   "description": "コレクションのインデックスがディスクで占める大きさです（1レプリカ分。全体では、レプリカの数を掛けます）。文書を消しても、セグメントのマージまでは減りません。増え方を、ディスクの空きと見比べます。"
  },
  {
   "id": 39,
   "title": "ディスク容量（空き・全体）",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min by (instance) (solr_metrics_node_core_root_fs_bytes{item=\"usableSpace\"})",
     "legendFormat": "{{instance}} 空き"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (instance) (solr_metrics_node_core_root_fs_bytes{item=\"totalSpace\"})",
     "legendFormat": "{{instance}} 全体"
    }
   ],
   "description": "Solr のホームがあるディスクの空きと全体です。ほかのプログラムのファイルも含みます。空きが減り続けるなら、インデックスのサイズと比べ、ディスクを足すか、インデックスに入れるものを見直します。"
  },
  {
   "id": 13,
   "title": "検索の質（検索語と利用者は表示しない）",
   "type": "row",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 14,
   "title": "0件率（直近1時間）",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "検索なし",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(solr_search_searches_total{result=\"zero\"}[1h])) / sum(increase(solr_search_searches_total{result=~\"found|zero\"}[1h]))",
     "legendFormat": "zero"
    }
   ],
   "description": "検索のうち、何もヒットしなかった割合です。低いほど良く、10%で橙、25%で赤です（暫定値。運用しながら調整します）。高いなら、管理ページの「検索ログ」で、0件だった語を見て、同義語の一覧やインデックスの欠けを直します。"
  },
  {
   "id": 15,
   "title": "クリック率（直近1時間）",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 49,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
