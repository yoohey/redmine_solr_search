# try-minimal: try it out on your PC. Redmine with sample data, one Solr, Tika.
#   cp env.example.try-minimal .env
#   docker compose up -d
# Then open http://localhost:3000/ and log in as admin / password (a few minutes after the first start: the sample data
# goes in, then the index is made).
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.redmine.yaml:compose.solr.yaml:compose.tika.yaml
# with monitoring (Grafana at http://localhost:3001/, admin / admin): use this line instead
#COMPOSE_FILE=compose.redmine.yaml:compose.solr.yaml:compose.tika.yaml:compose.monitoring.yaml

# Fine as they are for trying it out. Change them before anyone else can reach it.
SEED_PASSWORD=password
DB_PASSWORD=redmine
SECRET_KEY_BASE=change-me-this-is-for-trying-it-out-only
REDMINE_PORT=3000
REDMINE_VERSION=6.1.5
SOLR_HEAP=512m
