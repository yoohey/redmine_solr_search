# full: for the Redmine you already run, production-like. SolrCloud (2 Solr, 3 ZooKeeper, nginx), Tika, ManifoldCF and
# monitoring; no Redmine here.
#   cp env.example.full .env
#   docker compose up -d
# Tell Redmine where Solr and Tika are and run the scheduler there (see env.example.minimal, also before changing *_BIND), and give
# it the same METRICS_TOKEN (its environment variable SOLR_SEARCH_METRICS_TOKEN) for the dashboard's Redmine panels;
# Prometheus here then reads it at redmine:3000, so edit monitoring/prometheus.yml to Redmine's real address.
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.solrcloud.yaml:compose.tika.yaml:compose.manifoldcf.yaml:compose.monitoring.yaml

MCF_SOURCE_DIR=./data/mcf-source
MCF_SOURCE_PATH=/source
METRICS_TOKEN=change-me-metrics-token
GRAFANA_ADMIN_PASSWORD=change-me
SOLR_BIND=127.0.0.1
SOLR_PORT=8983
TIKA_BIND=127.0.0.1
TIKA_PORT=9998
SOLR_HEAP=1g
