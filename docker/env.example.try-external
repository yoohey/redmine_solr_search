# try-external: try external sources too. Redmine with sample data, one Solr, Tika, and ManifoldCF crawling a folder.
#   cp env.example.try-external .env      (set MCF_SOURCE_DIR below to the folder to crawl)
#   docker compose up -d
# Redmine: http://localhost:3000/ (admin / password). ManifoldCF: http://localhost:8345/mcf-crawler-ui/ (admin / admin).
# Then make the source: docker/manifoldcf/add-folder (the collection, the job), and register it on Redmine's admin page.
COMPOSE_PROJECT_NAME=redmine-solr-search
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.redmine.yaml:compose.solr.yaml:compose.tika.yaml:compose.manifoldcf.yaml
# with monitoring (Grafana at http://localhost:3001/, admin / admin): use this line instead
#COMPOSE_FILE=compose.redmine.yaml:compose.solr.yaml:compose.tika.yaml:compose.manifoldcf.yaml:compose.monitoring.yaml

# The folder to crawl (on this host), and where ManifoldCF sees it (that path goes into the index)
MCF_SOURCE_DIR=./data/mcf-source
MCF_SOURCE_PATH=/source

# Fine as they are for trying it out. Change them before anyone else can reach it.
SEED_PASSWORD=password
DB_PASSWORD=redmine
SECRET_KEY_BASE=change-me-this-is-for-trying-it-out-only
REDMINE_PORT=3000
REDMINE_VERSION=6.1.5
SOLR_HEAP=512m
